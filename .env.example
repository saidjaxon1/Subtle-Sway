# Copy this file to .env (it is ignored by git) and fill in the values.

# Wall Art root folder (read-only for the importer)
WALL_ART_ROOT=/mnt/F2540508856C9A8C/SAIDJAXON/Etsy/Wall Art

# PRIVATE repository that stores drafts (owner/name)
DRAFTS_REPO=saidjaxon1/Subtle-Sway-drafts

# Fine-grained GitHub token with access ONLY to the drafts repository:
# Repository access → Only select repositories → Subtle-Sway-drafts
# Permissions → Contents: Read and write
# This token cannot touch the public site, so the importer can never publish.
IMPORT_TOKEN=
